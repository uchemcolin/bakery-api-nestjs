// Prisma schema — this is the single source of truth for your database.
// We mirror the Laravel `users` migration but drop the password column:
// in a BFF, Laravel/NestJS never stores passwords.
generator client {
  provider = "prisma-client-js"
  // We intentionally do NOT set a custom `output` path here.
  // When you set a custom output (e.g. "../src/generated/prisma"), SQLite
  // relative paths like `file:./dev.db` break because Prisma resolves
  // them relative to the generated client, not the project root.
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  // Auto-incrementing integer primary key, same as Laravel's $table->id().
  id          Int      @id @default(autoincrement())

  // `oidcIssuer` + `oidcSubject` together uniquely identify a user
  // across the IdP. This is the SSO identity mapping from the PDF.
  oidcIssuer  String?
  oidcSubject String?

  // Basic profile fields we mirror from the Keycloak userinfo endpoint.
  name        String
  email       String?

  // Timestamps mirror Laravel's ->timestamps().
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // The unique constraint mirrors Laravel's:
  // $table->unique(['oidc_issuer', 'oidc_subject']);
  // Prisma needs a name for the compound unique so we can query it later.
  @@unique([oidcIssuer, oidcSubject])
}